+// Gazebo ray returns one instantaneous scan. Do not invent ring or point timestamps:
+// use the scan header as the common capture time (curvature=0 ms for all points).
+void Preprocess::gazebo_instant_handler(const sensor_msgs::msg::PointCloud2::UniquePtr &msg)
+{
+  pl_surf.clear();
+  pcl::PointCloud<pcl::PointXYZI> input;
+  pcl::fromROSMsg(*msg, input);
+  pl_surf.reserve(input.size());
+  const int stride = std::max(1, point_filter_num);
+  for (size_t i = 0; i < input.size(); i += stride)
+  {
+    const auto &src = input.points[i];
+    if (!std::isfinite(src.x) || !std::isfinite(src.y) || !std::isfinite(src.z) ||
+        src.x * src.x + src.y * src.y + src.z * src.z <= blind * blind)
+      continue;
+    PointType point;
+    point.x = src.x;
+    point.y = src.y;
+    point.z = src.z;
+    point.intensity = src.intensity;
+    point.normal_x = point.normal_y = point.normal_z = 0.f;
+    point.curvature = 0.f;
+    pl_surf.push_back(point);
+  }
+}
